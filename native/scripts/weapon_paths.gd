static func modifiers(id,weapon):
	if preload("res://scripts/god_content.gd").owns(id):return preload("res://scripts/god_content.gd").modifiers(id,weapon)
	id=UNION_BASES.get(id,id)
	var result={}
	for milestone in [5,10]:
		var branch=weapon.get("branches",{}).get(str(milestone),"")
		for option in STANDARD_CHOICES.get(id,{}).get(str(milestone),[]):
			if option.id!=branch:continue
			for key in option.stats:result[key]=result.get(key,0.0)+option.stats[key]
	return result
static func choices(id, milestone,weapon={}):
	if preload("res://scripts/god_content.gd").owns(id):return preload("res://scripts/god_content.gd").choices(id,milestone,weapon)
	id=UNION_BASES.get(id,id)
	if id=="club" and milestone==5:return ANCESTOR_CHOICES.get(milestone,[])
	if STANDARD_CHOICES.has(id):return STANDARD_CHOICES[id].get(str(milestone),[])
	return TFK_CHOICES.get(id,BEAMS.CHOICES.get(id,{})).get(milestone,[])
static func pending(id, weapon):
	for milestone in [5,10]:
		if id=="club" and milestone==5 and weapon.get("evolved",false):continue
		if weapon.get("level",1)>=milestone and not choices(id,milestone,weapon).is_empty() and not weapon.get("branches",{}).has(str(milestone)):
			return milestone
	return 0
static func choose(id, weapon, milestone, branch):
	if pending(id,weapon)!=milestone:return false
	if not choices(id,milestone,weapon).any(func(option):return option.id==branch):return false
	if not weapon.has("branches"):weapon.branches={}
	weapon.branches[str(milestone)]=branch
	return true
